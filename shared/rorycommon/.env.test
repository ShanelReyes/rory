MICTLANX_CLIENT_ID=test_client_id
MICTLANX_TIMEOUT=100
MICTLANX_API_VERSION=4
MICTLANX_MAX_WORKERS=4
MICTLANX_BUCKET_ID=rory
MICTLANX_OUTPUT_PATH=/rory/mictlanx
MICTLANX_PROTOCOL=http
MICTLANX_URI=mictlanx://mictlanx-router-0@localhost:63666?api_version=4&protocol=http
MICTLANX_DEBUG=0
RORY_KEYS_PATH=/rory/keys/test
RORY_COMMON_CTX_FILENAME=ctx
RORY_COMMON_PUBKEY_FILENAME=pubkey
RORY_COMMON_SECRETKEY_FILENAME=secretkey
RORY_COMMON_SECURITY_LEVEL=128
RORY_COMMON_RECORDS=10
RORY_COMMON_ATTRIBUTES=10
RORY_COMMON_ENV_FILE_PATH=./.env.test

RORY_COMMON_LOG_PATH=./.rory_common/log
RORY_COMMON_LOG_CONSOLE_HANDLER_LEVEL=DEBUG
RORY_COMMON_LOG_DISABLED=0
RORY_COMMON_LOG_RICH=1
RORY_COMMON_LOG_TO_FILE=0
RORY_COMMON_LOG_ERROR_TO_FILE=0
RORY_COMMON_LOG_INTERVAL=24
RORY_COMMON_LOG_FILE_HANDLER_LEVEL=INFO
RORY_COMMON_LOG_MICTLANX_PROPAGATE=1

MICTLANX_LOG_PATH=./.mictlanx/log
MICTLANX_LOG_DISABLED=1
MICTLANX_LOG_TO_FILE=0
MICTLANX_LOG_ERROR_FILE=0
MICTLANX_LOG_LEVEL=INFO
MICTLANX_LOG_RICH=0
MICTLANX_LOG_JSON_INDENT=4
MICTLANX_LOG_ROTATION_WHEN=h
MICTLANX_LOG_ROTATION_INTERVAL=24
MICTLANX_LOG_CONSOLE_LEVEL=DEBUG
MICTLANX_LOG_FILE_LEVEL=INFO
