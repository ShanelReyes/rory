RORY_DEBUG=1
RORY_CLIENT_IMAGE=rory:client
ENV_FILE_PATH=.env
NODE_ID=rory-client-0
NODE_IP_ADDR=127.0.0.1
NODE_PORT=3000
SERVER_IP_ADDR=0.0.0.0
RORY_MANAGER_IP_ADDR=rory-manager-0
RORY_MANAGER_PORT=6000
MAX_WORKERS=2
NUM_CHUNKS=1
WORKER_TIMEOUT=300
MAX_ITERATIONS=10
LIU_SECURITY_LEVEL=128
LIU_SECURE_RANDOM=0
LIU_SEED=123
LIU_USE_NP_RANDOM=1
LIU_ROUND=0
LIU_DECIMALS=6
CKKS_ROUND=0
CKKS_DECIMALS=2
CTX_FILENAME=ctx
PUBKEY_FILENAME=pubkey
SECRET_KEY_FILENAME=secretkey
RELINKEY_FILENAME=relinkey
ROTATEKEY_FILENAME=rotatekey
RELOAD=0
NP_RANDOM=1
TESTING=0
LOGGER_NAME=rory-client-0
SOURCE_PATH=/rory/source
SINK_PATH=/rory/sink
LOG_PATH=/rory/log
KEYS_PATH=/rory/keys
# RORY_CLIENT_LOG_JSON_FORMATTER_INDENT=
# --- MictlanX Configuration ---
MICTLANX_CLIENT_ID=rory-client-0_mictlanx
MICTLANX_TIMEOUT=120
MICTLANX_MAX_WORKERS=4
MICTLANX_BUCKET_ID=rory
MICTLANX_LOG_DISABLE=1
MICTLANX_LOG_PATH=/rory/mictlanx
MICTLANX_LOG_INTERVAL=24
MICTLANX_LOG_WHEN=h
MICTLANX_DELAY=2
MICTLANX_BACKOFF_FACTOR=0.5
MICTLANX_MAX_RETRIES=10
MICTLANX_PROTOCOL=http
MICTLANX_API_VERSION=4
MICTLANX_URI=mictlanx://mictlanx-router-0@mictlanx-router-0:60666?api_version=4&protocol=http

# --- Rory Client Log Configuration ---
RORY_CLIENT_LOG_INTERVAL=24
RORY_CLIENT_LOG_WHEN=h
RORY_CLIENT_LOG_JSON_FORMATTER_INDENT=0
RORY_CLIENT_LOG_DISABLED=0
RORY_CLIENT_LOG_ERROR_TO_FILE=1
RORY_CLIENT_LOG_FILE_HANDLER_LEVEL=20
RORY_CLIENT_LOG_LEVEL=10
RORY_CLIENT_LOG_TO_FILE=1
RORY_CLIENT_LOG_USE_RICH=0

# --- Gunicorn ---
GUNICORN_WORKERS=1
GUNICORN_MAX_THREADS=1
GUNICORN_WORKER_TIMEOUT=3600
RORY_MAX_REQUESTS=100
